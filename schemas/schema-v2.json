{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Waypoint Workspace Schema v2",
  "description": "Active Schema v2 specification for Waypoint portfolio and task management with hybrid ID architecture and root team roster.",
  "type": "object",
  "required": [
    "schemaVersion",
    "lastUpdated",
    "classification",
    "enums",
    "hierarchy",
    "memberFlags",
    "teamRoster",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Fixed schema version identifier (2)."
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of last workspace modification."
    },
    "classification": {
      "type": "string",
      "description": "Security classification marking (e.g. UNCLASSIFIED, CUI, SECRET)."
    },
    "enums": {
      "type": "object",
      "required": ["type", "status", "health"],
      "properties": {
        "type": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed workstream item types."
        },
        "status": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed workstream item statuses ('Completed' replaces 'Done')."
        },
        "health": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "hierarchy": {
      "type": "array",
      "description": "Configurable multi-tier hierarchy definition.",
      "items": {
        "type": "object",
        "required": ["level", "type", "label", "icon"],
        "properties": {
          "level": { "type": "integer" },
          "type": { "type": "string" },
          "label": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    },
    "memberFlags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Available team member category tags (e.g. primary, support, inactive)."
    },
    "teamRoster": {
      "type": "array",
      "description": "Centralized workspace team roster.",
      "items": {
        "$ref": "#/definitions/teamMemberV2"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "Single-root array containing the primary workstream.",
      "items": {
        "$ref": "#/definitions/taskItemV2"
      }
    }
  },
  "definitions": {
    "teamMemberV2": {
      "type": "object",
      "required": ["id", "displayId", "uuid", "name"],
      "properties": {
        "id": { "type": "string", "example": "TM-001" },
        "displayId": { "type": "string", "example": "TM-001" },
        "uuid": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "officePhone": { "type": "string" },
        "cellPhone": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "taskItemV2": {
      "type": "object",
      "required": ["id", "displayId", "uuid", "type", "title", "status", "health", "progress"],
      "properties": {
        "id": { "type": "string", "example": "PRJ-001" },
        "displayId": { "type": "string", "example": "PRJ-001" },
        "uuid": { "type": "string", "format": "uuid" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["Not Started", "In Progress", "Blocked", "Completed"] },
        "health": { "type": "string", "enum": ["Green", "Yellow", "Red"] },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
        "leadId": { "type": "string", "description": "References team member id or uuid" },
        "assigneeId": { "type": "string", "description": "References team member id or uuid" },
        "startDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "endStateVision": { "type": "string" },
        "definitionOfDone": { "type": "string" },
        "notes": { "type": "string" },
        "subTasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/taskItemV2" }
        }
      }
    }
  }
}
